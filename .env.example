# =====================================================================
# RAG MEGATHON — LLM PROVIDER & API KEY CONFIGURATION
# =====================================================================
# Copy this file to '.env' and fill in your API key.
# You can easily edit LLM_PROVIDER or LLM_MODEL if tokens run out!

# Active Provider Option: 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini

# Active Model Name (e.g. 'gemini-2.5-flash', 'gemini-1.5-flash', 'gemini-1.5-pro', 'gpt-4o-mini')
LLM_MODEL=gemini-2.5-flash

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key (Backup Provider if Gemini tokens run out)
OPENAI_API_KEY=your_openai_api_key_here
